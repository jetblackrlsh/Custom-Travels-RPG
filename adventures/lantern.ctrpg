        "home": [
          "#",
          "^scene:home",
          "/#",
          "ev",
          "str",
          "^late",
          "/str",
          {
            "x()": "flag",
            "exArgs": 1
          },
          "/ev",
          [
            {
              "->": ".^.b",
              "c": true
            },
            {
              "b": [
                "^By the time your lantern shines over Lowwater, the lowest cellars have flooded. Your warning guides the remaining rescue boats safely home.",
                {
                  "->": "home.11"
                },
                null
              ]
            }
          ],
          [
            {
              "->": ".^.b"
            },
            {
              "b": [
                "^Your lantern shines over Lowwater before the flood reaches its lowest houses. The rescue boats follow your warning and everyone gets clear.",
                {
                  "->": "home.11"
                },
                null
              ]
            }
          ],
          "nop",
          "^ You opened the floodgate and returned with the signal. Your choices, injuries, and spent charges remain in the journal.",
          "\n",
          "end",
          null
        ],
        "defeat": [
          "#",
          "^scene:defeat",
          "/#",
          "^Your strength gives out. The rescue crew finds you and carries you to shelter, but you cannot finish the mission tonight. This is a genuine failed attempt, not a secretly adjusted roll. Start a new adventure run to try another approach.",
          "\n",
          "end",
          null
        ],
